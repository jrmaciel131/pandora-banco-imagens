# ─────────────────────────────────────────────────────────────
#  Banco de Imagens — Hardening + páginas de erro
# ─────────────────────────────────────────────────────────────

# Esconde listagem de diretórios e versão do Apache
Options -Indexes
ServerSignature Off

# ── Páginas de erro estilizadas (com redirect 5s para home) ──
ErrorDocument 400 /404.html
ErrorDocument 401 /403.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 405 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /500.html
ErrorDocument 503 /500.html

# ── Cabeçalhos de segurança ──────────────────────────────────
<FilesMatch "\.(json|php)$">
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>

Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://lh3.googleusercontent.com https://drive.google.com; connect-src 'self' https://servicodados.ibge.gov.br; frame-ancestors 'none';"

# HSTS — só ativa em HTTPS (DreamHost serve via SSL)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# ── Bloqueio de pastas e arquivos sensíveis ──────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia acesso à pasta de sessões (segurança em camadas)
    RewriteRule ^sessions(/|$) - [F,L]

    # Bloqueia acesso à antiga pasta /config (caso ainda exista no servidor)
    # Após confirmar que /config foi apagado do servidor, esta regra pode ser removida.
    RewriteRule ^config(/|$) - [F,L]
</IfModule>

# ── Bloqueia arquivos sensíveis por padrão de nome ───────────
<FilesMatch "(?i)(\.(env|ini|log|bak|swp|sql|sh|conf|htaccess|htpasswd|json)$|^\.|~$|composer\.(json|lock)$|package(-lock)?\.json$)">
    Require all denied
</FilesMatch>

# Exceção: o frontend precisa carregar arquivos .json se houver
# (descomente se o site servir JSONs públicos no futuro)
# <Files "manifest.json">
#     Require all granted
# </Files>
