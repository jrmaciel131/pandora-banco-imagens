# ───────────────────────────────────────────────────────────
# .gitignore — Banco de Imagens (Projeto PANDORA)
# ───────────────────────────────────────────────────────────
# Tudo que estiver listado aqui o Git IGNORA. Ou seja: mesmo
# se o arquivo existir na sua pasta, ele NÃO vai para o GitHub.
# Use isso para proteger segredos, caches, sessões e lixo do SO.
# ───────────────────────────────────────────────────────────

# ── Segredos e credenciais (NUNCA versionar) ──────────────
# secrets.local.php guarda DB_PASS, CRON_KEY e as chaves do Turnstile.
# Aqui no repositório há apenas um MODELO sanitizado (placeholders).
private-config/secrets.local.php
private-config/google-credentials.json
private-config/passwords.json
private-config/users_override.json
private-config/.token_cache.json
private-config/production_users.json
private-config/presence.json
private-config/presence.json.lock

# Atenção: o config.php ENTRA no repositório, MAS já está
# sanitizado (com placeholders "dado x aqui"). Se você
# preencher os valores reais para usar localmente, ANTES de
# comitar troque-os pelos placeholders de novo — ou mova o
# config.php para a lista abaixo descomentando esta linha:
# private-config/config.php

# ── Sessões PHP em runtime ────────────────────────────────
private-config/sessions/*
!private-config/sessions/.gitkeep

# ── Caches gerados em runtime ─────────────────────────────
# A pasta `dominio.com/` é o document root local. No seu servidor pode ter
# outro nome (ex.: `public_html/` ou o nome real do seu domínio).
dominio.com/thumbs/*
!dominio.com/thumbs/.gitkeep
dominio.com/thumbs-po/*
!dominio.com/thumbs-po/.gitkeep
dominio.com/thumbs-teste/*
!dominio.com/thumbs-teste/.gitkeep
private-config/.token_cache.json
private-config/tags.json
private-config/distance_config.json
private-config/distance_overrides.json

# ── Relatório V3 (/relatorio): saídas e lixo de teste — NÃO versionar ─────
# uploads/ guarda PDFs e imagens reais de clientes; _phptest e old são
# rascunhos. token/ guarda o token da Meta (Graph API) em texto — segredo.
# Nada disso deve ir para o Git (nem no privado nem no público).
dominio.com/relatorio/uploads/
dominio.com/relatorio/_phptest/
dominio.com/relatorio/old/
dominio.com/relatorio/token/

# ── Arquivos do Windows / Mac / Linux ─────────────────────
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
*.swp
*.swo
*~

# ── IDEs e editores ───────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.history/

# ── Logs e dumps ──────────────────────────────────────────
*.log
*.sql
*.sqlite
*.sqlite3
*.dump
error_log
debug.log

# ── Backups e temporários ─────────────────────────────────
*.bak
*.backup
*.old
*.orig
*.tmp
~$*

# ── Variáveis de ambiente locais ──────────────────────────
.env
.env.local
.env.*.local

# ── Dependências (se um dia o projeto usar) ───────────────
vendor/
node_modules/
composer.lock
package-lock.json
